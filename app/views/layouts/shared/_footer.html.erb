<!-- footer -->
<footer class="pt-lg-10 pt-5 footer bg-white">
  <div class="container">
    <div class="row">
      <div class="col-lg-4 col-md-6 col-12">
        <!-- about company -->
        <div class="mb-4">
          <h3>
            <%= t(".organization_name", name: Current.tenant.name) %>
          </h3>

          <div class="mt-2">
            <p>
              <%= t(".call") %>
              <%= link_to t(".action"),
              (
                if Rails.env.production?
                  "https://www.homewardtails.org/organization_account_request/new"
                else
                  "http://localhost:3000/organization_account_request/new"
                end
              ) %>
            </p>
          </div>
        </div>
      </div>

      <div class="offset-lg-1 col-lg-2 col-md-3 col-6">
        <div class="mb-4">
          <!-- socials -->
          <h3 class="fw-bold mb-3"><%= t(".socials") %></h3>
          <ul class="list-unstyled nav nav-footer flex-column nav-x-0">
            <% if Current.tenant&.facebook_url.present? || Current.tenant&.instagram_url.present? %>
              <li class="d-flex gap-3">
                <% if Current.tenant&.facebook_url.present? %>
                  <%= link_to Current.tenant.facebook_url, class: "nav-link", target: "_blank", aria: { label: "Find us on facebook" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
                      <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/>
                    </svg>
                  <% end %>
                <% end %>

                <% if Current.tenant&.instagram_url.present? %>
                  <%= link_to Current.tenant.instagram_url, class: "nav-link", target: "_blank", aria: { label: "Find us on instagram" } do %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-instagram" viewBox="0 0 16 16">
                      <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003z"/>
                    </svg>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="col-lg-3 col-md-6 col-12">
        <!-- contact info -->
        <div class="mb-4">
          <h3 class="fw-bold mb-3">Get in touch</h3>
          <p>
            <%= Current.tenant.locations.last&.city_town %>,
            <%= Current.tenant.locations.last&.province_state %>
            <%= Current.tenant.locations.last&.country %>
          </p>
          <p class="mb-1">
            Email:
            <a href="mailto:<%= Current.tenant.email %>"><%= Current.tenant.email %></a>
          </p>
          <% if Current.tenant.phone_number.present? %>
            <p>
              Phone:
              <span class="text-dark fw-semibold"><%= Current.tenant.formatted_phone_number %></span>
            </p>
          <% end %>
        </div>
      </div>

      <div class="col-lg-2 col-md-6 col-12">
        <!-- feedback -->
        <div class="mb-4">
          <h3 class="fw-bold mb-3"><%= t(".feedback") %></h3>
          <p>
            <%= link_to t(".action"), new_feedback_path %>
            <%= t(".support") %>
          </p>
        </div>
      </div>
    </div>

    <div class="row flex align-items-center border-top py-2 justify-content-between">
      <!-- legal links -->
      <div class="col-12 col-lg-4">
        <nav class="nav nav-footer justify-content-start w-100 my-lg-0 my-2">
          <%= link_to t(".policy"), privacy_policy_path, target: "_blank", class: "nav-link ps-0" %>
        </nav>
      </div>

      <div class="col-12 col-lg-4 d-flex justify-content-start justify-content-lg-center">
        <span>
          © <%= Time.current.year %> <%= t(".rights") %>
        </span>
      </div>

      <div class="col-12 col-lg-4 d-flex justify-content-end">
        <%= render "shared/powered_by" %>
      </div>
    </div>
  </div>
</footer>
